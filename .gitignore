.venv/
__pycache__/
*.pyc
*.egg-info/
config.yaml
.pytest_cache/

# Build output
build/
dist/

# App data — never commit trade journals, databases, or settings holding tokens
CheeseSignals/
*.db
settings.json

# Generated at build time by the PyInstaller spec
packaging/kps.ico

# JS overlay: node deps are installed on demand.
web/qt-orb/node_modules/
web/qt-orb/package-lock.json

# The bundle is committed on purpose, against the blanket dist/ rule above: it
# is the single file a user pastes into the trading page, and telling them to
# install node and run a build first defeats the point of shipping it.
!web/qt-orb/dist/
!web/qt-orb/dist/orb-overlay.js
